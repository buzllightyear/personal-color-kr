# =============================================================================
# personal-color-kr — Environment Variables (Example)
# =============================================================================
# Copy this file to .env at the repo root and replace placeholder values with
# real credentials. The .env file is gitignored and MUST NOT be committed.
#
# Loading conventions:
#   - apps/mobile         → loaded via app.config.ts `extra` block (Expo)
#   - packages/core-python → loaded via python-dotenv `find_dotenv()`
#   - apps/api            → loaded via python-dotenv `find_dotenv()` + docker-compose
#                           reads POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
#                           via env_file: ./.env
#
# Security:
#   - Never commit a populated .env file.
#   - FAL_API_KEY is server-side only; it MUST NOT be bundled into the mobile
#     app binary or exposed to the client at runtime.
# =============================================================================

# -----------------------------------------------------------------------------
# PostHog — product analytics (client SDK)
# -----------------------------------------------------------------------------
# Project API key from https://us.posthog.com/project/settings (Project API Key).
# Used by posthog-react-native in apps/mobile via the PostHogClient wrapper in
# packages/core-ts. This key is safe to bundle in the mobile client.
# Expected format: phc_<base64-ish-string>
POSTHOG_API_KEY=phc_PLACEHOLDER_REPLACE_WITH_REAL_KEY_FROM_POSTHOG_DASHBOARD

# PostHog ingestion host. Use the US cloud by default; switch to
# https://eu.i.posthog.com if the project lives in the EU region.
POSTHOG_HOST=https://us.i.posthog.com

# --- PostHog Cohort API pull integration (Phase 4.4 — apps/api, server-side) ---
# The backend pulls PostHog cohort *definitions* (pull-only; no server-side
# capture push) via the Cohort REST API. These two values are SERVER-SIDE
# ONLY — they MUST NOT be bundled into the mobile client.
#
# POSTHOG_PERSONAL_API_KEY is a Personal API Key (NOT the phc_ project key
# above), created at https://us.posthog.com/settings/user-api-keys. It is sent
# as a Bearer token by api.posthog.posthog_cohort_client. Treat it as a secret
# (same hygiene as JWT_SECRET / FAL_API_KEY).
# Expected format: phx_<alphanumeric-string>
POSTHOG_PERSONAL_API_KEY=phx_PLACEHOLDER_REPLACE_WITH_PERSONAL_API_KEY_SERVER_SIDE_ONLY

# POSTHOG_PROJECT_ID is the numeric project identifier used to build the
# /api/projects/{project_id}/cohorts/{cohort_id} URL path. Find it in the
# PostHog project settings URL.
POSTHOG_PROJECT_ID=00000

# -----------------------------------------------------------------------------
# Superwall — paywall / subscription management (keys-only this phase)
# -----------------------------------------------------------------------------
# Public API key from https://superwall.com/applications (Settings → Keys).
# SDK install is DEFERRED to Phase 2.5 (requires custom dev client). For this
# phase the key is only validated by regex; no SDK calls are made.
# Expected format: pk_<alphanumeric-string>
SUPERWALL_API_KEY=pk_PLACEHOLDER_REPLACE_WITH_REAL_KEY_FROM_SUPERWALL_DASHBOARD

# -----------------------------------------------------------------------------
# Fal.ai — generative image / vision API (server-side only)
# -----------------------------------------------------------------------------
# API key from https://fal.ai/dashboard/keys.
# Format: <key_id>:<key_secret>
# IMPORTANT: This key MUST stay server-side. It is exercised by the standalone
# smoke script at packages/core-python/scripts/smoke_fal.py and will move to
# the FastAPI backend in Phase 4. Do NOT add it to app.config.ts `extra`.
FAL_API_KEY=REPLACE_WITH_FAL_KEY_FROM_https_fal_ai_dashboard_keys

# -----------------------------------------------------------------------------
# Content generation — object storage + admin (apps/api, server-side only)
# -----------------------------------------------------------------------------
# These back the content-generation feature (recipe catalog → fal.ai generation
# → gallery). All are SERVER-SIDE ONLY and absent-by-default: with the S3_* set
# unset, apps/api falls back to a process-local in-memory bucket so the flow
# still boots locally/in CI (images just aren't durable). Set them for real
# Cloudflare R2 / AWS S3.
#
# ADMIN_TOKEN is the static bearer token guarding every /v1/admin/recipes route
# (operator-only recipe lifecycle). Unset → admin routes reject with 403.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# S3-compatible object store for generated (watermarked) images. R2 and AWS S3
# both speak the same SigV4 REST API; api.storage.s3_object_storage signs with
# stdlib hmac (no boto3). All four S3_* below are required together — any unset
# → in-memory fallback. The secret key is a credential (JWT_SECRET hygiene).
#   - R2:  S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com, region auto
#   - AWS: S3_ENDPOINT_URL=https://s3.<region>.amazonaws.com, region <region>
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Signing region for the SigV4 credential scope. Defaults to "auto" (R2
# convention) when unset; AWS deployments should set the real region.
S3_REGION=auto

# Retention window (days) for generated images. The gallery hides expired rows
# at read time and api.services.generation_sweep.run_sweep deletes them.
# Sensible-default knob — unset/invalid falls back to 30; never fail-fast.
IMAGE_TTL_DAYS=30

# -----------------------------------------------------------------------------
# Postgres — local docker-compose database (Phase 4.1, apps/api)
# -----------------------------------------------------------------------------
# docker-compose.yml at the repo root reads these three vars via `env_file`
# to bootstrap the postgres:16 container. apps/api reads DATABASE_URL via
# python-dotenv `find_dotenv()`. Production host (Supabase managed) is
# deferred to Phase 4.3 when Apple Sign In + Supabase Auth are provisioned.
POSTGRES_USER=pck
POSTGRES_PASSWORD=pck_dev_only
POSTGRES_DB=pck

# DATABASE_URL consumed by apps/api/src/api/db/engine.py via the
# `postgresql+asyncpg://` async driver scheme. Defaults to the docker-compose
# service on localhost:5432.
DATABASE_URL=postgresql+asyncpg://pck:pck_dev_only@127.0.0.1:5432/pck

# DATABASE_URL_TEST points at the test database used by the apps/api pytest
# integration tier. CI sets this via env vars pointing at the postgres:16
# service container (see .github/workflows/ci.yml). Local dev can reuse the
# same Postgres instance with a separate DB name.
DATABASE_URL_TEST=postgresql+asyncpg://pck:pck_dev_only@127.0.0.1:5432/pck_test

# -----------------------------------------------------------------------------
# Apple Sign In auth (Phase 4.3 — apps/api)
# -----------------------------------------------------------------------------
# JWT_SECRET is the HS256 signing key for the backend's stateless 24h access
# token (issued by POST /v1/auth/sign-in-with-apple, verified by the
# require_current_user dependency on POST /v1/diagnose). The app fails to
# start if this variable is missing.
#
# Generate a strong value in dev/prod:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# Rotation: changing this value invalidates every issued token. Plan a
# rolling window when rotating in production (Phase 5+ may add a key-id
# header so the verifier can accept multiple secrets during transition).
JWT_SECRET=replace-with-random-256-bit-hex-from-python-secrets-token_hex-32

# APPLE_BUNDLE_ID is the iOS app's bundle identifier; the apps/api auth
# verifier enforces the `aud` claim on every Apple ID token against this
# value. The app fails to start if this variable is missing. Mirror the
# value used by apps/mobile/app.json `ios.bundleIdentifier`.
APPLE_BUNDLE_ID=com.method.pov

# -----------------------------------------------------------------------------
# Mobile runtime — API base URL (Phase 7.4 launch)
# -----------------------------------------------------------------------------
# EXPO_PUBLIC_API_BASE_URL is the HTTPS origin the mobile app calls for
# diagnosis / generation / payment. `EXPO_PUBLIC_`-prefixed vars are inlined
# into the JS bundle at build time, so this points at the DEPLOYED backend
# (NOT localhost) for any preview/production EAS build.
#   - Local dev (simulator):  http://127.0.0.1:8000
#   - Render (testing host):   https://pov-api.onrender.com
#   - Fly.io (launch host):    https://pov-api.fly.dev   (suspended during testing)
# Must end WITHOUT a trailing slash. See docs/deploy-api-fly.md.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# Sentry observability (Phase 7.2 / 7.3 — apps/api + apps/mobile)
# -----------------------------------------------------------------------------
# Two DSNs: one per Sentry project. Empty/unset disables Sentry init (the
# code no-ops gracefully), which is the correct local-dev default.
#   - SENTRY_DSN_API     — backend (sentry-sdk[fastapi]); read by apps/api.
#   - SENTRY_DSN_MOBILE  — @sentry/react-native; read via app.config.ts extra.
SENTRY_DSN_API=
SENTRY_DSN_MOBILE=

# SENTRY_AUTH_TOKEN is an EAS Secret (NOT a runtime var): the @sentry/react-
# native Expo config plugin uses it at BUILD time to upload iOS source maps for
# readable stack traces. Without it the plugin no-ops (builds still succeed,
# crash reports just show minified frames). Set it as an EAS Secret, not in a
# committed .env:  eas secret:create --name SENTRY_AUTH_TOKEN --value <token>
SENTRY_AUTH_TOKEN=

# Sentry org/project slugs consumed by the mobile source-map upload plugin
# (apps/mobile/app.config.ts). Replace the TODO_ placeholders in that file or
# override here once the Sentry projects exist.
SENTRY_ORG_SLUG=
SENTRY_PROJECT_SLUG_MOBILE=
SENTRY_PROJECT_SLUG_API=
