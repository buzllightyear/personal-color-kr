{
  "name": "personal-color-kr",
  "version": "0.1.0",
  "private": true,
  "description": "한국 시장 셀피 user 트렌드 맞춤 사진 편집/생성 앱 — 퍼스널 컬러 진단 hook + Glam Up 12단계 결제 깔때기 (한국 변형)",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10 <11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node scripts/check-toolchain.mjs",
    "build": "pnpm --filter core-ts run typecheck && pnpm --filter mobile exec tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter core-ts run test && (cd packages/core-python && python3 -m pytest -q)",
    "test:coverage": "pnpm --filter core-ts run test:coverage && (cd packages/core-python && python3 -m pytest -q)"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.17"
    },
    "patchedDependencies": {
      "@react-native/babel-plugin-codegen@0.81.5": "patches/@react-native__babel-plugin-codegen@0.81.5.patch"
    },
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.9.6",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^1.6.0"
  }
}
