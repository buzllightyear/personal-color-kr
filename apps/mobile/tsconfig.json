{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "Bundler",
    "allowJs": true,
    "baseUrl": ".",
    "types": ["node", "vitest/globals"],
    "paths": {
      "@mobile/*": ["src/*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "*.ts",
    "*.tsx"
  ],
  "exclude": ["node_modules", ".expo", "dist", "build"]
}
