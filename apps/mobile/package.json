{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "build:ios:simulator": "eas build --profile development --platform ios --local",
    "build:ios:dev": "eas build --profile development --platform ios",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint app src tests",
    "lint:fix": "eslint app src tests --fix",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@babel/runtime": "^7.20.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native/assets-registry": "0.76.9",
    "@sentry/cli": "2.31.2",
    "@sentry/react-native": "~6.10.0",
    "@superwall/react-native-superwall": "^2.0.7",
    "core-ts": "workspace:*",
    "dotenv": "^16.4.7",
    "expo": "~52.0.49",
    "expo-apple-authentication": "~7.1.3",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.20",
    "expo-font": "~13.0.4",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.22",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "expo-store-review": "~8.0.1",
    "expo-updates": "~0.27.5",
    "posthog-react-native": "^4.45.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/config-plugins": "~9.0.17",
    "@testing-library/react-native": "^12.9.0",
    "@types/react": "~18.3.31",
    "@types/react-test-renderer": "18.3.1",
    "babel-preset-expo": "~12.0.12",
    "eas-cli": "^12.0.0",
    "react-test-renderer": "18.3.1"
  }
}
