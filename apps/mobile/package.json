{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "build:ios:simulator": "npx eas-cli build --profile development --platform ios --local",
    "build:ios:dev": "npx eas-cli build --profile development --platform ios",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint app src tests",
    "lint:fix": "eslint app src tests --fix",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@babel/runtime": "^7.20.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native/assets-registry": "0.76.9",
    "@sentry/cli": "2.31.2",
    "@sentry/react-native": "~6.14.0",
    "@superwall/react-native-superwall": "^2.0.7",
    "core-ts": "workspace:*",
    "dotenv": "^16.4.7",
    "expo": "~53.0.27",
    "expo-apple-authentication": "~7.2.4",
    "expo-asset": "~11.1.7",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-font": "~13.3.2",
    "expo-image-picker": "~16.1.4",
    "expo-linking": "~7.1.7",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-status-bar": "~2.2.3",
    "expo-store-review": "~8.1.5",
    "expo-updates": "~0.28.18",
    "posthog-react-native": "^4.45.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "~0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/config-plugins": "~10.1.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.0.14",
    "@types/react-test-renderer": "19.0.0",
    "babel-preset-expo": "~13.0.0",
    "react-test-renderer": "19.0.0"
  }
}
