{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "build:ios:simulator": "eas build --profile development --platform ios --local",
    "build:ios:dev": "eas build --profile development --platform ios",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint app src tests",
    "lint:fix": "eslint app src tests --fix",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@babel/runtime": "^7.20.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native/assets-registry": "0.74.87",
    "@sentry/cli": "2.31.2",
    "@sentry/react-native": "~5.24.3",
    "@superwall/react-native-superwall": "^2.0.7",
    "core-ts": "workspace:*",
    "dotenv": "^16.4.7",
    "expo": "~51.0.39",
    "expo-constants": "~16.0.2",
    "expo-dev-client": "~4.0.29",
    "expo-font": "~12.0.10",
    "expo-image-picker": "~15.1.0",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.24",
    "expo-status-bar": "~1.12.1",
    "expo-store-review": "~7.0.2",
    "expo-updates": "~0.25.28",
    "posthog-react-native": "^4.45.6",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^12.9.0",
    "@types/react": "~18.2.79",
    "@types/react-test-renderer": "18.0.7",
    "babel-preset-expo": "~11.0.0",
    "eas-cli": "^12.0.0",
    "react-test-renderer": "18.2.0"
  }
}
