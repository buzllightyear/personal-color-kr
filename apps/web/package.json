  },
  "dependencies": {
    "next": "^15.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.3.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
