# Editor / OS
*.log
.DS_Store

# Env
.env
.env.local
.env.*.local

# Apple / App Store Connect submit credentials (Phase 7.4 launch).
# The ASC API key (.p8) is the secret EAS Submit uses to upload builds; it
# must never be committed. Provide it at deploy time via the gitignored
# credentials/ dir or the EXPO_ASC_API_KEY_PATH env var (see docs/deploy-api-fly.md).
credentials/
*.p8
*.pem
*.mobileprovision

# Stray repo-root app.json: `eas` commands run from the repo root (instead of
# apps/mobile) create a bare app.json stub here. The real Expo config is
# apps/mobile/app.json — a root-level one must never be committed.
/app.json

# This is a pnpm workspace — npm lockfiles must never exist. A committed
# package-lock.json makes Expo/EAS pick npm, which then chokes on pnpm's
# `workspace:*` protocol (EUNSUPPORTEDPROTOCOL). pnpm-lock.yaml is the only lock.
package-lock.json
**/package-lock.json
yarn.lock

# Local tool state
.openchrome/
.ouroboros/
.ouroboros_eval_artifact.md

# drift-check surfaced output (regenerated; not committed — spec §7)
docs/drift-report.md
docs/superpowers/**/*.review.md
.claude/codex-app-server-logs/
